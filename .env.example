# --- Sources gratuites (activées par défaut, aucune clé requise) ---
# Flatfox et APPT ne nécessitent pas de clé.

# Active/désactive des sources (true/false). Par défaut : flatfox + appt uniquement.
SOURCE_FLATFOX=true
SOURCE_APPT=true

# --- Sources via Apify (optionnelles, groupe SMG : anti-bot) ---
# Ces portails (Homegate, ImmoScout24, Anibis) ont un anti-bot sérieux et des CGU
# restrictives. Le plus simple pour un usage perso est de passer par un acteur Apify.
# Laisse ces variables vides pour garder ces sources désactivées.
SOURCE_HOMEGATE=false
SOURCE_IMMOSCOUT=false
SOURCE_ANIBIS=false

# Jeton Apify (https://console.apify.com/account#/integrations)
APIFY_TOKEN=
# Identifiants des acteurs Apify à utiliser (format "user~actor").
# À choisir dans le store Apify selon le portail visé.
APIFY_ACTOR_FLATFOX=
APIFY_ACTOR_HOMEGATE=
APIFY_ACTOR_IMMOSCOUT=
APIFY_ACTOR_ANIBIS=

# --- Zone de recherche par défaut (bounding box canton de Genève, approx.) ---
GE_NORTH=46.35
GE_SOUTH=46.12
GE_EAST=6.32
GE_WEST=5.95
