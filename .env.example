# --- Sources gratuites (activées par défaut, aucune clé requise) ---
# Flatfox et APPT ne nécessitent pas de clé.

# Active/désactive des sources (true/false). Par défaut : flatfox + appt uniquement.
SOURCE_FLATFOX=true
SOURCE_APPT=true

# --- Sources via Apify (optionnelles, groupe SMG : anti-bot) ---
# Ces portails (Homegate, ImmoScout24, Anibis) ont un anti-bot sérieux et des CGU
# restrictives. Le plus simple pour un usage perso est de passer par un acteur Apify.
# Laisse ces variables vides pour garder ces sources désactivées.
SOURCE_HOMEGATE=false
SOURCE_IMMOSCOUT=false
SOURCE_ANIBIS=false

# Jeton Apify (https://console.apify.com/account#/integrations)
APIFY_TOKEN=
# Identifiants des acteurs Apify à utiliser (format "user~actor").
# À choisir dans le store Apify selon le portail visé.
APIFY_ACTOR_FLATFOX=
APIFY_ACTOR_HOMEGATE=
APIFY_ACTOR_IMMOSCOUT=
APIFY_ACTOR_ANIBIS=

# --- Zone de recherche par défaut (bounding box canton de Genève, approx.) ---
GE_NORTH=46.35
GE_SOUTH=46.12
GE_EAST=6.32
GE_WEST=5.95

# --- Notifications push (Web Push / VAPID) ---
# Générer UNE fois une paire de clés :   npx web-push generate-vapid-keys
# Copier la "Public Key" dans VAPID_PUBLIC_KEY ET NEXT_PUBLIC_VAPID_PUBLIC_KEY,
# la "Private Key" dans VAPID_PRIVATE_KEY. La clé privée reste côté serveur :
# ne jamais la préfixer par NEXT_PUBLIC_ ni la commiter.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact de l'expéditeur, exigé par les services push (mailto: ou https:).
VAPID_SUBJECT=mailto:moi@exemple.ch
# Même valeur que VAPID_PUBLIC_KEY, exposée au navigateur (lue au build).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Secret protégeant GET /api/cron/notify (?token=… ou Authorization: Bearer …).
# Ex. : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
